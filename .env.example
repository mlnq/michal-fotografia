# Dane logowania do skrzynki SMTP (np. skrzynka OVH), z której wysyłany jest formularz kontaktowy.
# SMTP_SECURE musi być "true" dla portu 465 i "false" dla portu 587.
# Adres odbiorcy wiadomości NIE jest ustawiany tutaj — bierze się z pola marka.email w content.js.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
